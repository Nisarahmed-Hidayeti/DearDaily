# Separate DEVELOPMENT project only. Never place secret/service-role keys here.
VITE_SUPABASE_URL=https://your-development-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_development_publishable_key
# UI gate only. Supabase must separately disable new signups for a closed beta.
VITE_ALLOW_SIGNUP=false

# Enable only after real-account isolation and hosted migration verification pass.
VITE_ENABLE_JOURNALS=false

# Enable only after the Phase 4 hosted migration and real-session tests pass.
VITE_ENABLE_COMMUNITY=false

# Requires approved writing-document migration and hosted persistence/privacy tests.
VITE_ENABLE_RICH_EDITOR=false

# Public site key only. Secret key belongs exclusively in Supabase Auth settings.
# Signup remains unavailable if this is missing, even with VITE_ALLOW_SIGNUP=true.
VITE_TURNSTILE_SITE_KEY=
# Additive Renaissance settings/profile migration and hosted tests required.
VITE_ENABLE_RENAISSANCE_DATA=false
# Private media endpoint + Storage/RLS migration and hosted isolation tests required.
VITE_ENABLE_MEDIA=false

# Enable only after hosted Google setup and real OAuth callback tests pass.
VITE_ENABLE_GOOGLE_AUTH=false
